# MAX
MAX_BOT_TOKEN=""
MAX_BOT_USERNAME=t801_hakaton_max_bot

MAX_INIT_DATA_TTL_SECONDS=3600

# Server
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=""

# PostgreSQL: Compose needs only POSTGRES_PASSWORD.
POSTGRES_PASSWORD=""
DATABASE_URL=""
# External database: set one CA option.
DATABASE_CA_PATH=""
DATABASE_CA_PEM=""

# Text parsing; optional for manual input.
YANDEX_API_KEY=""
YANDEX_FOLDER_ID=""

# 2GIS server keys
DGIS_PLACES_API_KEY=""
DGIS_ROUTING_API_KEY=""
DGIS_BACKUP_API_KEY=""
# Second backup
DGIS_TERTIARY_API_KEY=""

# Optional verified mode: limits apply to the shared subscription.
DGIS_ROUTING_LIMIT_MINUTE=5
DGIS_ROUTING_LIMIT_DAY=50
DGIS_ROUTING_LIMIT_MONTH=1000
DGIS_ROUTING_INITIAL_DAY=""
DGIS_ROUTING_INITIAL_DAY_USED=""
DGIS_ROUTING_INITIAL_MONTH=""
DGIS_ROUTING_INITIAL_MONTH_USED=""

# Browser-visible map key; restrict allowed origins.
DGIS_MAPGL_API_KEY=""
# Allow a shared demo key to be exposed in the browser.
DGIS_MAPGL_ALLOW_SHARED_DEMO_KEY=false

# external: open roads in 2GIS; verified: use Routing API.
PLANNING_ROUTING_MODE=external

# yandex only for a configured async revision; empty for local Compose.
MAX_WEBHOOK_ASYNC=""
