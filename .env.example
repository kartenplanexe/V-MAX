# Copy this file to .env.local. Never commit real values.
# Server-only secret. Never expose it through VITE_* variables or frontend code.
MAX_BOT_TOKEN=
# Username registered for the existing bot; change only for a different bot.
MAX_BOT_USERNAME=t801_hakaton_max_bot

# MAX recommends treating initData as valid for no longer than one hour.
MAX_INIT_DATA_TTL_SECONDS=3600

# Local/server runtime. Hosting may override these values.
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=

# Shared PostgreSQL. Direct connection or session pooling, NOT transaction-mode PgBouncer.
# For local Docker use docker compose --env-file .env.local up --build -d.
# No real credentials in this file; set a URL-safe local password in .env.local.
POSTGRES_PASSWORD=
DATABASE_URL=
# Optional absolute path to PostgreSQL CA certificate (cloud TLS must verify the server).
DATABASE_CA_PATH=
# Alternative for Yandex Lockbox: public PEM CA as a multiline secret value.
# Set only one CA option. Do NOT paste server.key or ca.key here.
DATABASE_CA_PEM=

# Server-only Alice Flash access (not VITE_*). Folder must have ai.languageModels.user access.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Cross-instance daily caps, including failed/unknown-outcome requests; no automatic retries.

# 2GIS provider keys. Keep Places and Routing on the server.
# A demo key may temporarily be repeated in all three variables locally.
# Production refuses to expose MapGL when it equals either server-only key.
DGIS_PLACES_API_KEY=
DGIS_ROUTING_API_KEY=
DGIS_BACKUP_API_KEY=

# MapGL runs in the browser, so this value is intentionally delivered to the
# frontend. Use a separate production key and restrict it by allowed origins in
# 2GIS Platform Manager.
DGIS_MAPGL_API_KEY=
