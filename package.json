{
  "name": "v-max",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json && node scripts/copy-server-assets.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "dev": "concurrently --kill-others --success first npm:dev:server npm:dev:client",
    "dev:client": "vite",
    "dev:server": "node --watch --import tsx src/server/index.ts",
    "deploy:yandex:live": "node scripts/deploy-yandex-live.mjs --apply",
    "env:init": "node scripts/init-env.mjs",
    "planner:demo": "node scripts/planner.mjs demo",
    "planner:flow:demo": "node --import tsx scripts/demo-place-planning.mts",
    "planner:form:demo": "npm run build:client && node --import tsx scripts/demo-planner-form.mts",
    "planner:test": "node scripts/planner.mjs test",
    "planner:run": "node scripts/planner.mjs run",
    "smoke:2gis": "node scripts/smoke-2gis.mjs",
    "smoke:2gis:address": "node --env-file=.env.local --use-system-ca --import tsx scripts/probe-2gis-address.mts",
    "smoke:max": "node scripts/smoke-max-token.mjs",
    "max:commands": "node --use-system-ca scripts/configure-max-commands.mjs",
    "start": "node dist/server/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@2gis/mapgl": "1.78.0",
    "@fastify/static": "10.1.4",
    "@maxhub/max-ui": "0.5.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.5",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/pg": "8.15.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
